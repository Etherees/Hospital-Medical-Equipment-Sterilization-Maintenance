<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_SterilflowMain" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0">
  <bpmn:collaboration id="Collaboration_Sterilflow">
    <bpmn:participant id="Participant_SterilflowSystem" name="STERILFLOW Hospital Sterilization &#38; Maintenance Platform (Siemens Healthineers Architecture)" processRef="sterilflow-main-process" />
  </bpmn:collaboration>
  <bpmn:process id="sterilflow-main-process" name="Hospital Medical Equipment Sterilization &#38; Maintenance Process" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Sterilflow">
      <bpmn:lane id="Lane_ORStaff" name="Operating Theater (OR) Staff">
        <bpmn:flowNodeRef>StartEvent_SterilizationRequested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterEquipment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CSSD" name="Central Sterile Supply Department (CSSD)">
        <bpmn:flowNodeRef>Task_InitialInspection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifyCleaning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CleaningPassed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CleaningRework</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_MultiTrayProcessing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryEvent_QualityRejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QA" name="Quality Assurance &#38; Regulatory Release">
        <bpmn:flowNodeRef>Task_FinalQualitySignoff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryEvent_FinalSignoffTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendOverdueAlert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FinalApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateEquipmentStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateSterilizationCert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_EquipmentReleased</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FlagCorrectiveMaintenance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_QuarantinedForMaintenance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessStoppedAtQuality</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNotification</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_SterilizationRequested" name="Sterilization Request Logged">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_RegisterEquipment" name="Register Equipment &#38; Trays">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="register-equipment" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_InitialInspection" name="Initial Inspection &#38; Bio-Burden Check">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="cssd-technician" />
        <zeebe:formDefinition formKey="camunda-forms:bpmn:initial-inspection-form" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:incoming>Flow_ReworkLoop</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_VerifyCleaning" name="Automated Ultrasonic Wash Verification">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="verify-cleaning" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_CleaningPassed" name="Cleaning Successful?" default="Flow_CleaningPassedYes">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_CleaningPassedYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_CleaningPassedNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CleaningRework" name="Enzymatic Rework &#38; Re-Clean">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="cssd-technician" />
        <zeebe:formDefinition formKey="camunda-forms:bpmn:cleaning-rework-form" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CleaningPassedNo</bpmn:incoming>
      <bpmn:outgoing>Flow_ReworkLoop</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_FinalQualitySignoff" name="Final Quality Sign-Off">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="qa-manager" />
        <zeebe:formDefinition formKey="camunda-forms:bpmn:quality-signoff-form" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_TraysCompleted</bpmn:incoming>
      <bpmn:outgoing>Flow_SignoffDone</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="BoundaryEvent_FinalSignoffTimer" name="Overdue Alert (2h)" cancelActivity="false" attachedToRef="Task_FinalQualitySignoff">
      <bpmn:outgoing>Flow_OverdueSignoffTimer</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Signoff">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_SendOverdueAlert" name="Send Supervisor Overdue Alert">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-overdue-alert" retries="2" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_OverdueSignoffTimer</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_FinalApproval" name="Approved for Release?" default="Flow_FinalApprovalYes">
      <bpmn:incoming>Flow_SignoffDone</bpmn:incoming>
      <bpmn:outgoing>Flow_FinalApprovalYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_FinalApprovalNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_UpdateEquipmentStatus" name="Update Equipment Status (AVAILABLE)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="update-equipment-status" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_FinalApprovalYes</bpmn:incoming>
      <bpmn:outgoing>Flow_CertGenerated</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_GenerateSterilizationCert" name="Generate NIST ISO 11134 Certificate">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generate-sterilization-certificate" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CertGenerated</bpmn:incoming>
      <bpmn:outgoing>Flow_ReleaseNotified</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_EquipmentReleased" name="Equipment Released for Surgery">
      <bpmn:incoming>Flow_11bmwou</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_FlagCorrectiveMaintenance" name="Flag Corrective Maintenance Ticket">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="flag-corrective-maintenance" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_FinalApprovalNo</bpmn:incoming>
      <bpmn:outgoing>Flow_MaintFlagged</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_QuarantinedForMaintenance" name="Quarantined for Corrective Maintenance">
      <bpmn:incoming>Flow_MaintFlagged</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_SterilizationRequested" targetRef="Task_RegisterEquipment" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_RegisterEquipment" targetRef="Task_InitialInspection" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_InitialInspection" targetRef="Task_VerifyCleaning" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_VerifyCleaning" targetRef="Gateway_CleaningPassed" />
    <bpmn:sequenceFlow id="Flow_CleaningPassedYes" name="Passed" sourceRef="Gateway_CleaningPassed" targetRef="SubProcess_MultiTrayProcessing" />
    <bpmn:sequenceFlow id="Flow_CleaningPassedNo" name="Failed" sourceRef="Gateway_CleaningPassed" targetRef="Task_CleaningRework">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= cleaningPassed = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReworkLoop" sourceRef="Task_CleaningRework" targetRef="Task_InitialInspection" />
    <bpmn:sequenceFlow id="Flow_TraysCompleted" sourceRef="SubProcess_MultiTrayProcessing" targetRef="Task_FinalQualitySignoff" />
    <bpmn:sequenceFlow id="Flow_SignoffDone" sourceRef="Task_FinalQualitySignoff" targetRef="Gateway_FinalApproval" />
    <bpmn:sequenceFlow id="Flow_OverdueSignoffTimer" sourceRef="BoundaryEvent_FinalSignoffTimer" targetRef="Task_SendOverdueAlert" />
    <bpmn:sequenceFlow id="Flow_FinalApprovalYes" name="Approved" sourceRef="Gateway_FinalApproval" targetRef="Task_UpdateEquipmentStatus" />
    <bpmn:sequenceFlow id="Flow_FinalApprovalNo" name="Rejected" sourceRef="Gateway_FinalApproval" targetRef="Task_FlagCorrectiveMaintenance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= finalApprovalPassed = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CertGenerated" sourceRef="Task_UpdateEquipmentStatus" targetRef="Task_GenerateSterilizationCert" />
    <bpmn:sequenceFlow id="Flow_ReleaseNotified" sourceRef="Task_GenerateSterilizationCert" targetRef="Task_SendNotification" />
    <bpmn:sequenceFlow id="Flow_MaintFlagged" sourceRef="Task_FlagCorrectiveMaintenance" targetRef="EndEvent_QuarantinedForMaintenance" />
    <bpmn:subProcess id="SubProcess_MultiTrayProcessing" name="Parallel Surgical Tray Processing &#38; Verification (Multi-Instance)">
      <bpmn:incoming>Flow_CleaningPassedYes</bpmn:incoming>
      <bpmn:outgoing>Flow_TraysCompleted</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="= surgicalTrays" inputElement="currentTray" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="StartEvent_TrayProcessing" name="Tray Staged">
        <bpmn:outgoing>Flow_Sub_01</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_QueryIoTAutoclave" name="Query IoT Autoclave API (REST Connector)">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" />
          <zeebe:ioMapping>
            <zeebe:input source="= &#34;GET&#34;" target="method" />
            <zeebe:input source="= &#34;http://localhost:8085/api/autoclaves/AC-01/telemetry&#34;" target="url" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_Sub_01</bpmn:incoming>
        <bpmn:outgoing>Flow_Sub_02</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_ExecuteSterilizationCycle" name="Execute 134°C Autoclave Cycle">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="execute-sterilization-cycle" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_Sub_02</bpmn:incoming>
        <bpmn:outgoing>Flow_Sub_03</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="BoundaryEvent_SterilizationTimeout" name="Cycle Alert (15m)" cancelActivity="false" attachedToRef="Task_ExecuteSterilizationCycle">
        <bpmn:outgoing>Flow_TimeoutAlert</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerDef_Sterilization">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT15M</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:serviceTask id="Task_AlertTimeout" name="Dispatch Technician Alert">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="alert-technician" retries="2" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_TimeoutAlert</bpmn:incoming>
        <bpmn:outgoing>Flow_TimeoutHandled</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent_TimeoutHandled" name="Alert Dispatched">
        <bpmn:incoming>Flow_TimeoutHandled</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:boundaryEvent id="BoundaryEvent_SterilizationError" name="Thermal/Pressure Abort" attachedToRef="Task_ExecuteSterilizationCycle">
        <bpmn:outgoing>Flow_ThermalAbort</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorDef_SterilFail" errorRef="Error_AutoclaveCycleFailed" />
      </bpmn:boundaryEvent>
      <bpmn:serviceTask id="Task_VerifyChemicalIndicator" name="Verify Chemical Indicator Strip">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="verify-chemical-indicator" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_Sub_03</bpmn:incoming>
        <bpmn:outgoing>Flow_Sub_04</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="Gateway_IndicatorPassed" name="Indicator Passed?" default="Flow_IndicatorPassedYes">
        <bpmn:incoming>Flow_Sub_04</bpmn:incoming>
        <bpmn:outgoing>Flow_IndicatorPassedYes</bpmn:outgoing>
        <bpmn:outgoing>Flow_IndicatorPassedNo</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:callActivity id="CallActivity_BioContaminationQuarantine" name="Bio-Contamination Quarantine &#38; Re-Autoclave">
        <bpmn:extensionElements>
          <zeebe:calledElement processId="bio-contamination-quarantine" propagateAllChildVariables="true" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_IndicatorPassedNo</bpmn:incoming>
        <bpmn:incoming>Flow_ThermalAbort</bpmn:incoming>
        <bpmn:outgoing>Flow_QuarantineResolved</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:userTask id="Task_QualityInspection" name="Quality Inspection &#38; Seal Verification">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="qa-specialist" />
          <zeebe:formDefinition formKey="camunda-forms:bpmn:quality-signoff-form" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_IndicatorPassedYes</bpmn:incoming>
        <bpmn:incoming>Flow_QuarantineResolved</bpmn:incoming>
        <bpmn:outgoing>Flow_Sub_05</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="Gateway_QualityApproved" name="Quality Approved?" default="Flow_QualityApprovedYes">
        <bpmn:incoming>Flow_Sub_05</bpmn:incoming>
        <bpmn:outgoing>Flow_QualityApprovedYes</bpmn:outgoing>
        <bpmn:outgoing>Flow_QualityApprovedNo</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="EndEvent_QualityRejected" name="Quality Check Rejected">
        <bpmn:incoming>Flow_QualityApprovedNo</bpmn:incoming>
        <bpmn:errorEventDefinition id="ErrorDef_QualityRejected" errorRef="Error_QualityRejected" />
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="Gateway_CalibrationRequired" name="Calibration Required?" default="Flow_CalibrationNo">
        <bpmn:incoming>Flow_QualityApprovedYes</bpmn:incoming>
        <bpmn:outgoing>Flow_CalibrationYes</bpmn:outgoing>
        <bpmn:outgoing>Flow_CalibrationNo</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:callActivity id="CallActivity_BiomedicalCalibration" name="Invoke Biomedical Calibration Process">
        <bpmn:extensionElements>
          <zeebe:calledElement processId="biomedical-engineer-calibration" propagateAllChildVariables="true" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_CalibrationYes</bpmn:incoming>
        <bpmn:outgoing>Flow_CalibrationDone</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:endEvent id="EndEvent_TrayProcessing" name="Tray Certified">
        <bpmn:incoming>Flow_CalibrationNo</bpmn:incoming>
        <bpmn:incoming>Flow_CalibrationDone</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_Sub_01" sourceRef="StartEvent_TrayProcessing" targetRef="Task_QueryIoTAutoclave" />
      <bpmn:sequenceFlow id="Flow_Sub_02" sourceRef="Task_QueryIoTAutoclave" targetRef="Task_ExecuteSterilizationCycle" />
      <bpmn:sequenceFlow id="Flow_Sub_03" sourceRef="Task_ExecuteSterilizationCycle" targetRef="Task_VerifyChemicalIndicator" />
      <bpmn:sequenceFlow id="Flow_Sub_04" sourceRef="Task_VerifyChemicalIndicator" targetRef="Gateway_IndicatorPassed" />
      <bpmn:sequenceFlow id="Flow_IndicatorPassedYes" name="Passed" sourceRef="Gateway_IndicatorPassed" targetRef="Task_QualityInspection" />
      <bpmn:sequenceFlow id="Flow_IndicatorPassedNo" name="Failed" sourceRef="Gateway_IndicatorPassed" targetRef="CallActivity_BioContaminationQuarantine">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= chemicalIndicatorPassed = false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_ThermalAbort" sourceRef="BoundaryEvent_SterilizationError" targetRef="CallActivity_BioContaminationQuarantine" />
      <bpmn:sequenceFlow id="Flow_QuarantineResolved" sourceRef="CallActivity_BioContaminationQuarantine" targetRef="Task_QualityInspection" />
      <bpmn:sequenceFlow id="Flow_Sub_05" sourceRef="Task_QualityInspection" targetRef="Gateway_QualityApproved" />
      <bpmn:sequenceFlow id="Flow_QualityApprovedYes" name="Passed" sourceRef="Gateway_QualityApproved" targetRef="Gateway_CalibrationRequired" />
      <bpmn:sequenceFlow id="Flow_QualityApprovedNo" name="Failed" sourceRef="Gateway_QualityApproved" targetRef="EndEvent_QualityRejected">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= qualityPassed = false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_CalibrationYes" name="Yes" sourceRef="Gateway_CalibrationRequired" targetRef="CallActivity_BiomedicalCalibration">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= currentTray.calibrationRequired = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_CalibrationNo" name="No" sourceRef="Gateway_CalibrationRequired" targetRef="EndEvent_TrayProcessing" />
      <bpmn:sequenceFlow id="Flow_CalibrationDone" sourceRef="CallActivity_BiomedicalCalibration" targetRef="EndEvent_TrayProcessing" />
      <bpmn:sequenceFlow id="Flow_TimeoutAlert" sourceRef="BoundaryEvent_SterilizationTimeout" targetRef="Task_AlertTimeout" />
      <bpmn:sequenceFlow id="Flow_TimeoutHandled" sourceRef="Task_AlertTimeout" targetRef="EndEvent_TimeoutHandled" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_QualityHalt" sourceRef="BoundaryEvent_QualityRejected" targetRef="EndEvent_ProcessStoppedAtQuality" />
    <bpmn:boundaryEvent id="BoundaryEvent_QualityRejected" name="Quality Check Rejected" attachedToRef="SubProcess_MultiTrayProcessing">
      <bpmn:outgoing>Flow_QualityHalt</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_SubQualityRejected" errorRef="Error_QualityRejected" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="EndEvent_ProcessStoppedAtQuality" name="Process Stopped (Quality Check Rejected)">
      <bpmn:incoming>Flow_QualityHalt</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_SendNotification" name="Alert OR Scheduling Desk (Slack/Teams/Email Connector)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-notification" />
        <zeebe:ioMapping>
          <zeebe:input source="= &#34;or-scheduling@hospital.internal&#34;" target="to" />
          <zeebe:input source="= &#34;[STERILFLOW RELEASED] Trays Ready for OR - Batch #&#34; + requestId" target="subject" />
          <zeebe:input source="= &#34;Medical equipment and surgical trays for request &#34; + requestId + &#34; have been sterilized, certified, and released for surgical use.&#34;" target="body" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ReleaseNotified</bpmn:incoming>
      <bpmn:outgoing>Flow_11bmwou</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_11bmwou" sourceRef="Task_SendNotification" targetRef="EndEvent_EquipmentReleased" />
  </bpmn:process>
  <bpmn:error id="Error_AutoclaveCycleFailed" name="AutoclaveCycleFailed" errorCode="ERR_AUTOCLAVE_FAILED" />
  <bpmn:error id="Error_QualityRejected" name="QualityRejected" errorCode="ERR_QUALITY_REJECTED" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_Sterilflow">
    <bpmndi:BPMNPlane id="BPMNPlane_Sterilflow" bpmnElement="Collaboration_Sterilflow">
      <bpmndi:BPMNShape id="Participant_SterilflowSystem_di" bpmnElement="Participant_SterilflowSystem" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2320" height="880" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_QA_di" bpmnElement="Lane_QA" isHorizontal="true">
        <dc:Bounds x="190" y="680" width="2290" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CSSD_di" bpmnElement="Lane_CSSD" isHorizontal="true">
        <dc:Bounds x="190" y="260" width="2290" height="420" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ORStaff_di" bpmnElement="Lane_ORStaff" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="2290" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_SterilizationRequested_di" bpmnElement="StartEvent_SterilizationRequested">
        <dc:Bounds x="242" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="221" y="185" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RegisterEquipment_di" bpmnElement="Task_RegisterEquipment">
        <dc:Bounds x="330" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_InitialInspection_di" bpmnElement="Task_InitialInspection">
        <dc:Bounds x="330" y="320" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_VerifyCleaning_di" bpmnElement="Task_VerifyCleaning">
        <dc:Bounds x="480" y="320" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CleaningPassed_di" bpmnElement="Gateway_CleaningPassed" isMarkerVisible="true">
        <dc:Bounds x="635" y="335" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="629" y="305" width="63" height="27" />
